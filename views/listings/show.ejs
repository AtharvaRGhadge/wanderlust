<% layout("/layouts/boilerplate") %>
<div class="row mt-4">
    <div class="col-8 offset-2">
        <h3 style="color: black;"><%=listing.title%></h3>

        <div class="card mb-3 listing-card" style="background-color: transparent !important; border: none;">

            <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing_img" style="width: 100%; height: 20rem; object-fit: cover; border-radius: 10px;">

            <% if (listing.owner) { %>
                <p class="card-text mt-2" style="color: black;"><b>Owned by:</b> <%=listing.owner.username%></p>
            <% } %>

            <!-- Moved all details here, removed ul/li, and added border: none to fix the line -->
            <div class="card-body" style="padding: 1rem 0; color: black; border: none !important;">
                <p class="card-text" style="font-size: 1.25rem;"></p>
                <p class="card-text"><%=listing.description%></p>
                <p class="card-text"><b>Price:</b> &#8377;<%=listing.price.toLocaleString("en-IN")%></p>
                <p class="card-text"><b>Location:</b> <%=listing.location%></p>
                <p class="card-text"><b>Country:</b> <%=listing.country%></p>
            </div>
        </div> 

        <% if (currUser && listing.owner && String(listing.owner._id) === String(currUser._id)) { %>
            <div class="mb-5">
                <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark edit-btn">Edit</a>

                <form method="post" action="/listings/<%=listing._id%>?_method=DELETE" class="d-inline">
                    <button class="btn btn-danger">Delete</button>
                </form>
            </div>
        <% } %>
    </div>

    <div class="col-8 offset-2 mb-3">
        <hr>
        <h4>Leave a review!</h4>
        <% if (currUser) { %>
        <form action="/listings/<%=listing.id%>/reviews" method="post" data-bs-validate novalidate class="needs-validation">
            <fieldset class="starability-slot">
                <h5>Rating:</h5>
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" checked />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
            <!-- Comment Group (Textarea & Feedback MUST be in the same div) -->
            <div class="mb-3 mt-3">
                <label for="comment" class="form-label" style="color: black;">Comment</label>
                <textarea 
                    name="review[comment]" 
                    id="comment" 
                    cols="30" 
                    rows="5"
                    style="background-color: white; color: black;" 
                    class="form-control"
                    aria-describedby="descriptionInvalid"
                    required
                ></textarea>
                <div id="descriptionInvalid" class="invalid-feedback">
                    Please add some comments for review
                </div>
            </div>

            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <% } else { %>
            <p>Log in to leave a review.</p>
        <% } %>
            <hr>
        <%if(listing.reviews.length>0){%>
            <div class="row">
                <p><b>All Reviews</b></p>
                <% for(review of listing.reviews) { %>
                    <% if (review.author) { %>
                    <!-- Wrapper div handles grid layout and spacing -->
                    <div class="col-5 ms-3 mb-3">
                        <!-- Card div handles border, background, and rounded corners -->
                        <div class="card" style="background-color: white !important; border: 1px solid #d1d5db !important; border-radius: 10px;">
                            <div class="card-body" style="padding: 1rem;">
                                <h5 class="card-title" style="color: black;"><%= review.author ? `@${review.author.username}` : "Anonymous" %></h5>
                                <p class="starability-result card-text" data-rating=<%= review.rating %>>
                                    Rated: 3 stars
                                </p>
                                <p class="card-text" style="color: black;"><%= review.comment %></p>
                                
                                <!-- <p class="card-text" style="color: black;"><%= review.rating %> &#9733;</p> -->
                                <% if (currUser && review.author && String(review.author._id) === String(currUser._id)) { %>
                                    <form method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" class="mb-3">
                                        <button class="btn btn-sm btn-dark">Delete</button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% } %>
                <% } %>
            </div>
        <%}%>
    </div>
    <div class="col-8 offset-2 mb-3">
            <h3>Where you'll be</h3>
            <% if (listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2) { %>
                <div
                    id="map"
                    data-longitude="<%=listing.geometry.coordinates[0]%>"
                    data-latitude="<%=listing.geometry.coordinates[1]%>"
                    data-location="<%=listing.location%>"
                ></div>
            <% } else { %>
                <p>Map coordinates are not available for this listing yet. Edit the listing to geocode its location.</p>
            <% } %>
    </div>
</div>
<script type="module" src="/js/map.js?v=2"></script>
