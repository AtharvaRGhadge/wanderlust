<% layout("/layouts/boilerplate") %>
<!-- Added a container wrapper to give the page standard margins -->
<div class="container mt-4">
    <style>
        #filters{
            display: flex;
            flex-wrap: nowrap;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
            overflow-x: auto;
            padding-bottom: 0.5rem;
        }

        .filter{
            flex: 0 0 auto;
            margin-right: 0.3rem;
            opacity: 0.7;
            text-align: center;
        }

        .filter:hover{
            opacity: 1;
            cursor: pointer;
        }

        .filter p{
            margin: 0.25rem 0 0;
            font-size: 0.8rem;
            white-space: nowrap;
        }

        .tax-toggle{
            flex: 0 0 auto;
            box-sizing: border-box;
            border:1px solid black;
            border-radius: 1rem;
            padding: 0.5rem;
        }

        .tax-toggle-switch{
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: nowrap;
            white-space: nowrap;
            cursor: pointer;
        }

        .tax-toggle-input{
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
        }

        .tax-toggle-slider{
            position: relative;
            display: inline-block;
            flex: 0 0 auto;
            width: 2.5rem;
            height: 1.4rem;
            border-radius: 1rem;
            background-color: #adb5bd;
            transition: background-color 0.2s ease;
        }

        .tax-toggle-slider::before{
            position: absolute;
            top: 0.2rem;
            left: 0.2rem;
            width: 1rem;
            height: 1rem;
            border-radius: 50%;
            background-color: #fff;
            content: "";
            transition: transform 0.2s ease;
        }

        .tax-toggle-input:checked + .tax-toggle-slider{
            background-color: #fe424d;
        }

        .tax-toggle-input:checked + .tax-toggle-slider::before{
            transform: translateX(1.1rem);
        }

        .tax-toggle-input:focus-visible + .tax-toggle-slider{
            outline: 2px solid #222;
            outline-offset: 2px;
        }

        .tax-info{
            display: none;
        }

    </style>
    <div id="filters">
        <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic cities</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>
        <div class="filter">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-tractor"></i></div>
            <p>Farms</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Arctic</p>
        </div>
        <div class="tax-toggle" style="margin-left: 13rem;">
            <label class="tax-toggle-switch" for="switchMdLabel">
                <span>Display total after taxes</span>
                <input class="tax-toggle-input" type="checkbox" id="switchMdLabel" role="switch">
                <span class="tax-toggle-slider" aria-hidden="true"></span>
            </label>
        </div>
    </div>
    <% if (currUser) { %>
        <form method="get" action="/listings/new" class="mb-4 mt-3">
            <button class="btn btn-primary">Create New Listing</button>
        </form>
    <% } %>
    <!-- Native CSS Grid: Forces cards into responsive columns without framework classes -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: 2rem;"> 
        
        <% for(listing of allListings) { %>
            <!-- Set width to 100% so it fills its specific grid column -->
          <a href="/listings/<%=listing._id%>" class="listing-link">
            <div class="card listing-card" style="background-color: aliceblue; width: 100%; height: 100%;"> 
                
                <!-- Fixed image height and object-fit so different sized images don't stretch -->
                <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_image" style="height: 15rem; object-fit: cover;">
                <div class="card-img-overlay"></div>
                <div class="card-body" style="border-top: none;">
                    <p class="card-text" style="color: black;">
                        <b><%=listing.title%></b> <br>
                        &#8377;<%=listing.price.toLocaleString("en-IN")%>/night
                        <i class="tax-info">&nbsp;&nbsp;+18%GST</i>
                    </p>
                </div>
            </div>
          </a>
        <% } %>
        
    </div>
</div>

<script>
    let taxSwitch=document.getElementById("switchMdLabel")
    taxSwitch.addEventListener("click",()=>{
        let taxInfo=document.getElementsByClassName("tax-info")
        for(info of taxInfo){
            if(info.style.display!="inline"){
                info.style.display="inline"
            }else{
                info.style.display="none"
            }
        }
    })
</script>