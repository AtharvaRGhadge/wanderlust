<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
    <div class="col-8 offset-2">
        <br>
        <h3 style="color: black;">Create a new listing!</h3>
        
        <form method="post" action="/listings" data-bs-validate novalidate class="needs-validation" enctype="multipart/form-data">
            <!-- Title -->
            <div class="mb-3">
                <label for="title" class="form-label" style="color: black;">Title</label>
                <input 
                id="title" 
                name="listing[title]" 
                placeholder="Add a catchy title" 
                type="text" class="form-control" 
                style="background-color: white !important; 
                color: black !important;"
                aria-describedby="titleValid titleInvalid"
                required>
                <div id="titleValid" class="valid-feedback">Title looks good!</div>
                <div id="titleInvalid" class="invalid-feedback">Please enter a catchy title.</div>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label for="description" class="form-label" style="color: black;">Description</label>
                <textarea id="description" 
                name="listing[description]" 
                placeholder="enter description" 
                class="form-control" 
                style="background-color: white !important; 
                color: black !important;"
                aria-describedby="descriptionValid descriptionInvalid"
                required></textarea>
                <div id="descriptionValid" class="valid-feedback">Description looks good!</div>
                <div id="descriptionInvalid" class="invalid-feedback">Please enter a short description.</div>
            </div>
           
            <!-- Image Link -->
            <div class="mb-3">
                <label for="image" class="form-label" style="color: black;">Upload Listing Image</label>
                <input id="image" name="listing[image]" type="file" class="form-control" style="background-color: white !important; color: black !important;" required>
                <div id="imageValid" class="valid-feedback"></div>
                <!-- <div id="imageInvalid" class="invalid-feedback">Please enter a valid image URL.</div> -->
            </div>
            
            <!-- Price & Country -->
            <div class="row">
                <div class="mb-3 col-4 col-md-4">
                    <label for="price" class="form-label" style="color: black;">Price</label>
                    <input id="price" name="listing[price]" placeholder="1200" type="number" class="form-control" style="background-color: white !important; color: black !important;" aria-describedby="priceValid priceInvalid"
                    required
                    >
                    <div id="priceValid" class="valid-feedback">Price looks good!</div>
                    <div id="priceInvalid" class="invalid-feedback">Price should be valid.</div>
                </div>
                
                <div class="mb-3 col-8 col-md-8">
                    <label for="country" class="form-label" style="color: black;">Country</label>
                    <input id="country" name="listing[country]" placeholder="India" type="text" class="form-control" style="background-color: white !important; color: black !important;" aria-describedby="countryValid countryInvalid"
                    required>
                    <div id="countryValid" class="valid-feedback">Country looks good!</div>
                    <div id="countryInvalid" class="invalid-feedback">Country name should be valid.</div>
                </div>
            </div>
            
            <!-- Location -->
            <div class="mb-3">
                <label for="location" class="form-label" style="color: black;">Location</label>
                <input id="location" name="listing[location]" placeholder="Jaipur, Rajasthan" type="text" class="form-control" style="background-color: white !important; color: black !important;" aria-describedby="locationValid locationInvalid"
                required>
                <div id="locationValid" class="valid-feedback">Location looks good!</div>
                <div id="locationInvalid" class="invalid-feedback">Location should be valid.</div>
            </div>
            
            <button class="btn btn-dark mt-3 mb-5 add-btn">Add</button>
        </form>
        <br>
    </div>
</div>