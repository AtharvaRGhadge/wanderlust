<style>
  .search-btn{
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
  }
  .search-inp{
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
  }
</style>

<nav class="navbar md:navbar-expand bg-white border-bottom sticky-top"><!-- //to show bottom border & sticky-top class so navbar remains visible while scrolling-->
  <div class="container-fluid">
    <a class="navbar-brand" style="color: black !important;" href="/listings"><i class="fa-regular fa-compass"></i></a>
    
    <button class="btn-icon navbar-toggler" type="button" data-bs-toggle="drawer" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon" aria-hidden="true"></span>
    </button>

    <dialog class="drawer drawer-end bg-white" tabindex="-1" id="navbarNav" aria-labelledby="navbarNavLabel">
      <div class="drawer-header">
        <h5 class="drawer-title" style="color: black !important;" id="navbarNavLabel">Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close"></button>
      </div>
      <div class="drawer-body d-flex justify-content-between">
        <ul class="navbar-nav">
          <li class="nav-item">
            
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/listings">Explore</a>
          </li>
          <div class="navbar-nav ms-auto">
            <form class="d-flex" role="search">
              <input class="form-control me-2 search-inp" type="search" placeholder="Search destinations" aria-label="Search" style="color: black; background-color: white;"/>
              <button class="btn-outline search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
            </form>
          </div>
        </ul>
        <ul class="navbar-nav text-end me-6">
          <a class="nav-link" href="/listings/new">Airbnb your home</a>
          <% if (!currUser) { %>
            <li class="nav-item">
              <a class="nav-link" href="/signup"><b>Sign up</b></a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/login"><b>Login</b></a>
            </li>
          <% } else { %>
            <li class="nav-item">
              <a class="nav-link" href="/logout"><b>Logout</b></a>
            </li>
          <% } %>
        </ul>
      </div>
    </dialog>
  </div>
</nav>