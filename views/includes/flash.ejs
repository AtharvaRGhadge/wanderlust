<%if(success && success.length){%>
    <!-- becoz success is an array -->
    <div class="alert flash-message flash-success col-6 offset-3" role="alert">
        <%=success%>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<%}%>

<%if(error && error.length){%>
    <!-- becoz success is an array -->
    <div class="alert flash-message flash-error col-6 offset-3" role="alert">
        <%=error%>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<%}%>
