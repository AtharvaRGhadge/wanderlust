<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">SignUp for Wanderlust</h1>
    <div class="col-6 offset-3">
        <form action="/signup" method="post" class="needs-validation" novalidate>
            <!-- Title -->
            <div class="mb-3">
                <label for="username" class="form-label" style="color: black;">Username</label>
                <input
                id="username"
                name="username" 
                type="text" class="form-control" 
                style="background-color: white !important; 
                color: black !important;"
                required>
                <div id="titleValid" class="valid-feedback">Looks good!</div>
            </div>
            <!-- Email -->
            <div class="mb-3">
                <label for="email" class="form-label" style="color: black;">Email</label>
                <input
                id="email"
                name="email" 
                type="email" class="form-control" 
                style="background-color: white !important; 
                color: black !important;"
                required>
            </div>
            <!--Password-->
            <div class="mb-3">
                <label for="password" class="form-label" style="color: black;">Password</label>
                <input
                id="password"
                name="password" 
                type="password" class="form-control" 
                style="background-color: white !important; 
                color: black !important;"
                required>
            </div>
            <button class="btn btn-success" style="background-color: green;">SignUp</button>
        </form>
    </div>
</div>